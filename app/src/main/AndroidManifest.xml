<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for on-device app blocking & wellness monitoring -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    
    <!-- Usage statistics permission for counting daily app time -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".SocialBreakApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Main Single Activity UI with Compose Navigation & Deep Links -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep Link Handler: socialbreak://open?platform= -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="socialbreak" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Fullscreen App Blocker Interceptor Activity -->
        <activity
            android:name=".services.BlockedAppActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Accessibility Service: Full App Detection & Window Interception -->
        <service
            android:name=".services.AppBlockerService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_blocker_accessibility" />
        </service>

        <!-- Accessibility Service: Short-Form Reel / Short Interception -->
        <service
            android:name=".services.NativeReelsBlockerService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_blocker_accessibility" />
        </service>

        <!-- Local DNS Loopback VPN Service for System-Wide Web & Domain Blocking -->
        <service
            android:name=".services.WebBlockerVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Notification Listener Service: Clean Message Redirect -->
        <service
            android:name=".services.NotificationBlockerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- YouTube Background Media Playback Service -->
        <service
            android:name=".services.YouTubePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Device Admin Receiver: Prevents uninstall tampering during Hard Mode -->
        <receiver
            android:name=".receivers.UninstallProtectionReceiver"
            android:description="@string/app_name"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Boot Completed Receiver: Reschedules sleep and focus alarms upon reboot -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Home Screen Quick Launch Widget Providers -->
        <receiver
            android:name=".widgets.QuickLaunchWidgetProvider"
            android:exported="true"
            android:label="Quick Launch">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_quick_launch" />
        </receiver>

        <receiver
            android:name=".widgets.InstagramWidgetProvider"
            android:exported="true"
            android:label="Clean Instagram">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_platform" />
        </receiver>

        <receiver
            android:name=".widgets.YouTubeWidgetProvider"
            android:exported="true"
            android:label="Clean YouTube">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_platform" />
        </receiver>

        <receiver
            android:name=".widgets.TikTokWidgetProvider"
            android:exported="true"
            android:label="Clean TikTok">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_platform" />
        </receiver>

        <receiver
            android:name=".widgets.TwitterWidgetProvider"
            android:exported="true"
            android:label="Clean X">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_platform" />
        </receiver>

        <receiver
            android:name=".widgets.SnapchatWidgetProvider"
            android:exported="true"
            android:label="Clean Snapchat">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_platform" />
        </receiver>

        <receiver
            android:name=".widgets.FacebookWidgetProvider"
            android:exported="true"
            android:label="Clean Facebook">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_platform" />
        </receiver>

        <receiver
            android:name=".widgets.LinkedInWidgetProvider"
            android:exported="true"
            android:label="Clean LinkedIn">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_platform" />
        </receiver>

        <!-- Quick Settings Status Bar Tiles -->
        <service
            android:name=".services.FocusSprintTileService"
            android:icon="@android:drawable/ic_lock_idle_lock"
            android:label="Focus Sprint"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".services.SleepModeTileService"
            android:icon="@android:drawable/ic_lock_idle_alarm"
            android:label="Sleep Mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".services.HardModeTileService"
            android:icon="@android:drawable/ic_secure"
            android:label="Hard Mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
